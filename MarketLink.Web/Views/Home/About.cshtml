@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<div style="background:linear-gradient(135deg, var(--heading) 0%, var(--primary-dark) 100%);color:#fff;padding:80px 0 60px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-80px;right:-80px;width:300px;height:300px;background:rgba(255,255,255,0.04);border-radius:50%;"></div>
    <div style="position:absolute;bottom:-60px;left:-60px;width:240px;height:240px;background:rgba(216,233,131,0.06);border-radius:50%;"></div>
    
    <div class="container text-center position-relative" style="z-index:2;">
        <span class="badge px-3 py-2 rounded-pill mb-3" style="background:var(--secondary);color:var(--heading);font-weight:700;font-size:12px;letter-spacing:1px;text-transform:uppercase;">
            🌱 Rooted in Community
        </span>
        <h1 class="display-4 fw-bold mb-3" style="color:#fff;font-family:var(--font-heading);">
            Bridging Local Farms to Your Family's Table
        </h1>
        <p class="lead mx-auto mb-4" style="max-width:700px;color:rgba(255,255,255,0.85);font-size:18px;">
            MarketLink eGreen Basket is a digital agricultural marketplace uniting conscious consumers with hardworking local farmers for a healthier, fairer, and greener food system.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Products" asp-action="Index" class="btn btn-accent btn-pill btn-lg px-4">
                <i class="fas fa-shopping-basket me-2"></i>Explore Products
            </a>
            <a asp-controller="Farmers" asp-action="Index" class="btn btn-outline-light btn-pill btn-lg px-4">
                <i class="fas fa-tractor me-2"></i>Meet Our Farmers
            </a>
        </div>
    </div>
</div>

<!-- Stats Counter Section -->
<div class="container py-5" style="margin-top:-40px;position:relative;z-index:3;">
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 p-4 text-center h-100" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);">
                <div class="display-5 fw-bold text-primary-green mb-1" style="font-family:var(--font-heading);">50+</div>
                <div class="text-muted small fw-semibold text-uppercase">Verified Local Farms</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-4 text-center h-100" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);">
                <div class="display-5 fw-bold text-accent mb-1" style="font-family:var(--font-heading);">100%</div>
                <div class="text-muted small fw-semibold text-uppercase">Direct from Grower</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-4 text-center h-100" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);">
                <div class="display-5 fw-bold text-primary-green mb-1" style="font-family:var(--font-heading);">10k+</div>
                <div class="text-muted small fw-semibold text-uppercase">Fresh Deliveries</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 p-4 text-center h-100" style="background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);">
                <div class="display-5 fw-bold text-accent mb-1" style="font-family:var(--font-heading);">0</div>
                <div class="text-muted small fw-semibold text-uppercase">Middlemen Markups</div>
            </div>
        </div>
    </div>
</div>

<!-- Mission & Vision -->
<div class="container py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <div class="pe-lg-4">
                <span class="text-primary-green fw-bold text-uppercase small letter-spacing-1">Our Story & Purpose</span>
                <h2 class="fw-bold mt-2 mb-4" style="color:var(--heading);">Why We Built MarketLink eGreen Basket</h2>
                <p class="text-muted mb-3" style="font-size:16px;line-height:1.8;">
                    Every day, tons of fresh produce travel thousands of miles before reaching grocery store shelves, losing flavor, nutrients, and shelf life while generating massive carbon emissions. At the same time, smallholder farmers often struggle to get fair prices due to lengthy distributor chains.
                </p>
                <p class="text-muted mb-4" style="font-size:16px;line-height:1.8;">
                    MarketLink eliminates the middlemen. We empower local farmers to list their daily harvests directly to neighbors, restaurants, and families. You know exactly where your food comes from, when it was picked, and who grew it.
                </p>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width:36px;height:36px;border-radius:50%;background:rgba(92,111,43,0.1);display:flex;align-items:center;justify-content:center;color:var(--primary);flex-shrink:0;">
                            <i class="fas fa-check"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color:var(--heading);">Harvested at Peak Ripeness</h6>
                            <p class="text-muted small mb-0">Produce is harvested within hours of your pickup or delivery for unmatched flavor.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div style="width:36px;height:36px;border-radius:50%;background:rgba(222,128,43,0.1);display:flex;align-items:center;justify-content:center;color:var(--accent);flex-shrink:0;">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color:var(--heading);">Fair Compensation for Growers</h6>
                            <p class="text-muted small mb-0">Farmers retain up to 90% of retail sales, sustaining local family farming.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 p-4 p-md-5" style="background:var(--card);border-radius:var(--radius-lg);box-shadow:var(--shadow);border:1px solid var(--border);">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width:50px;height:50px;border-radius:14px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;">
                        <i class="fas fa-globe-americas"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color:var(--heading);">Our Core Values</h5>
                        <small class="text-muted">The principles guiding everything we do</small>
                    </div>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);">
                        <h6 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-leaf text-success me-2"></i>100% Transparency</h6>
                        <p class="small text-muted mb-0">Every product profile shows farm location, harvest methods, and farmer certifications.</p>
                    </div>
                    <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);">
                        <h6 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-heart text-danger me-2"></i>Community Well-Being</h6>
                        <p class="small text-muted mb-0">Supporting local farmers markets keeps money in the community and reduces food miles.</p>
                    </div>
                    <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);">
                        <h6 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-shield-alt text-primary me-2"></i>Guaranteed Freshness</h6>
                        <p class="small text-muted mb-0">If you're not delighted with the freshness of any item, our satisfaction policy has you covered.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- How it works 4 Steps -->
<div style="background:var(--card);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:80px 0;">
    <div class="container text-center">
        <span class="text-primary-green fw-bold text-uppercase small letter-spacing-1">Simple & Direct</span>
        <h2 class="fw-bold mt-2 mb-5" style="color:var(--heading);">How MarketLink Works</h2>

        <div class="row g-4 text-start">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4" style="background:var(--bg);border-radius:var(--radius);border:1px solid var(--border);">
                    <div style="width:48px;height:48px;border-radius:12px;background:var(--primary);color:#fff;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">1</div>
                    <h5 class="fw-bold mb-2" style="color:var(--heading);">Browse Produce</h5>
                    <p class="text-muted small mb-0">Explore fresh fruits, vegetables, dairy, and grains from farms located within your regional radius.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4" style="background:var(--bg);border-radius:var(--radius);border:1px solid var(--border);">
                    <div style="width:48px;height:48px;border-radius:12px;background:var(--accent);color:#fff;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">2</div>
                    <h5 class="fw-bold mb-2" style="color:var(--heading);">Fill Your Basket</h5>
                    <p class="text-muted small mb-0">Add custom quantities, filter for organic or seasonal items, and save favorites to your wishlist.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4" style="background:var(--bg);border-radius:var(--radius);border:1px solid var(--border);">
                    <div style="width:48px;height:48px;border-radius:12px;background:var(--primary);color:#fff;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">3</div>
                    <h5 class="fw-bold mb-2" style="color:var(--heading);">Farmer Prepares</h5>
                    <p class="text-muted small mb-0">The farmer receives your order, freshly harvests your items, and prepares your basket with care.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4" style="background:var(--bg);border-radius:var(--radius);border:1px solid var(--border);">
                    <div style="width:48px;height:48px;border-radius:12px;background:var(--accent);color:#fff;font-size:20px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">4</div>
                    <h5 class="fw-bold mb-2" style="color:var(--heading);">Pickup or Delivery</h5>
                    <p class="text-muted small mb-0">Pick up your order at a nearby market stall or convenient pickup slot, or enjoy doorstep delivery.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA Banner -->
<div class="container py-5 text-center">
    <div class="card border-0 p-5" style="background:linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);color:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);">
        <h2 class="fw-bold mb-3" style="color:#fff;font-family:var(--font-heading);">Ready to Taste the Difference of Truly Fresh Food?</h2>
        <p class="lead mx-auto mb-4" style="max-width:600px;color:rgba(255,255,255,0.9);">
            Join thousands of neighbors supporting regional farmers and feeding their families fresh, wholesome produce.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Products" asp-action="Index" class="btn btn-accent btn-pill btn-lg px-4">
                Shop Farm Fresh Today
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light btn-pill btn-lg px-4">
                Create an Account
            </a>
        </div>
    </div>
</div>
