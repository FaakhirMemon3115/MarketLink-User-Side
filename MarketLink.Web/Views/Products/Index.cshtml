@model IEnumerable<MarketLink.Core.Entities.Product>
@{
    ViewData["Title"] = "Shop Fresh Products";
}

<div style="background:var(--card);border-bottom:1px solid var(--border);padding:40px 0;">
    <div class="container text-center">
        <h1 style="font-weight:700;color:var(--heading);margin-bottom:16px;">Shop Farm Fresh</h1>
        <p style="color:var(--muted);max-width:600px;margin:0 auto;">
            Discover locally grown, organic, and seasonal produce directly from farmers in your community.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-lg-3 mb-4">
            <div class="card" style="border:none;box-shadow:var(--shadow-sm);border-radius:var(--radius);position:sticky;top:100px;">
                <div class="card-body p-4">
                    <form method="get" id="filterForm">
                        <input type="hidden" name="q" value="@ViewBag.Query" />
                        
                        <h6 style="font-weight:700;margin-bottom:16px;">Categories</h6>
                        <div class="d-flex flex-column gap-2 mb-4">
                            <a href="@Url.Action("Index", new { q = ViewBag.Query, isOrganic = ViewBag.IsOrganic, seasonal = ViewBag.Seasonal, sortBy = ViewBag.SortBy })" 
                               class="text-decoration-none @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "text-primary fw-bold" : "text-muted")">
                               All Products
                            </a>
                            @foreach(var cat in ViewBag.Categories)
                            {
                                <a href="@Url.Action("Index", new { categorySlug = cat.Slug, q = ViewBag.Query, isOrganic = ViewBag.IsOrganic, seasonal = ViewBag.Seasonal, sortBy = ViewBag.SortBy })" 
                                   class="text-decoration-none @(ViewBag.CurrentCategory == cat.Slug ? "text-primary fw-bold" : "text-muted")">
                                    @cat.Name
                                </a>
                            }
                        </div>

                        <h6 style="font-weight:700;margin-bottom:16px;">Filters</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="isOrganic" value="true" id="isOrganic" @(ViewBag.IsOrganic == true ? "checked" : "") onchange="document.getElementById('filterForm').submit()">
                            <label class="form-check-label" for="isOrganic">Organic Only</label>
                        </div>
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" name="seasonal" value="true" id="seasonal" @(ViewBag.Seasonal == true ? "checked" : "") onchange="document.getElementById('filterForm').submit()">
                            <label class="form-check-label" for="seasonal">In Season Now</label>
                        </div>

                        <h6 style="font-weight:700;margin-bottom:16px;">Sort By</h6>
                        <select name="sortBy" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                            <option value="">Newest</option>
                            <option value="price_asc" selected="@(ViewBag.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(ViewBag.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="name" selected="@(ViewBag.SortBy == "name")">Name: A-Z</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div style="color:var(--muted);font-size:14px;">
                    Showing <strong>@Model.Count()</strong> results
                    @if(!string.IsNullOrEmpty(ViewBag.Query)) { <span>for "@ViewBag.Query"</span> }
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-green btn-sm" onclick="document.querySelector('.ai-toggle-btn').click()"><i class="fas fa-magic me-2"></i>Smart Search</button>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div style="font-size:48px;margin-bottom:16px;">🛒</div>
                    <h5>No products found</h5>
                    <p class="text-muted">Try adjusting your filters or search query.</p>
                    <a asp-action="Index" class="btn btn-outline-green mt-3">Clear Filters</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var p in Model)
                    {
                        <div class="col-md-4 col-sm-6 animate-on-scroll">
                            <div class="card product-card h-100">
                                <div style="position:relative;">
                                    <a asp-action="Details" asp-route-slug="@p.Slug">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder.png" : p.ImageUrl)" class="card-img-top" alt="@p.Name" style="height:200px;object-fit:cover;">
                                    </a>
                                    @if (p.IsOrganic)
                                    {
                                        <span class="badge badge-success" style="position:absolute;top:10px;left:10px;">Organic</span>
                                    }
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <div style="font-size:12px;color:var(--muted);margin-bottom:4px;">@p.Category?.Name</div>
                                            <h6 style="margin:0;"><a asp-action="Details" asp-route-slug="@p.Slug" style="color:var(--heading);text-decoration:none;">@p.Name</a></h6>
                                        </div>
                                        <div style="font-weight:700;color:var(--primary);font-size:16px;">$@p.PricePerKg.ToString("0.00")<span style="font-size:11px;color:var(--muted);font-weight:normal;">/kg</span></div>
                                    </div>
                                    <div style="font-size:13px;color:var(--muted);margin-bottom:16px;">
                                        <i class="fas fa-tractor me-1"></i> @p.Farmer?.FarmName
                                    </div>
                                    
                                    <div class="mt-auto d-flex gap-2">
                                        <button class="btn btn-primary-green btn-sm w-100" onclick="ML.Cart.addItem(@p.Id, 1)"><i class="fas fa-shopping-basket me-2"></i>Add</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
