@model MarketLink.Web.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div style="background:var(--bg);min-height:80vh;display:flex;align-items:center;padding:40px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card border-0 shadow-lg" style="border-radius:24px;overflow:hidden;">
                    <div style="background:var(--accent);padding:32px;text-align:center;color:#fff;">
                        <h4 style="font-weight:700;margin:0;">Create Account</h4>
                        <p style="font-size:14px;opacity:0.9;margin:8px 0 0;">
                            @(Model.Role == "Farmer" ? "Start selling your local produce" : "Join our community of conscious shoppers")
                        </p>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:14px;"></div>
                            
                            <input type="hidden" asp-for="Role" />
                            
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Email Address</label>
                                <input asp-for="Email" class="form-control form-control-lg" style="font-size:14px;background:var(--bg);border:1px solid var(--border);" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Password</label>
                                <input asp-for="Password" class="form-control form-control-lg" style="font-size:14px;background:var(--bg);border:1px solid var(--border);" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                                <div class="form-text" style="font-size:11px;">Must be at least 6 characters with a number and special character.</div>
                            </div>
                            
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-lg" style="font-size:14px;background:var(--bg);border:1px solid var(--border);" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            
                            <button type="submit" class="btn btn-accent btn-lg btn-pill w-100 shadow">Sign Up</button>
                        </form>
                        
                        <div class="text-center mt-4">
                            <p style="font-size:14px;color:var(--body-text);margin:0;">
                                Already have an account? <a asp-action="Login" style="color:var(--primary);font-weight:600;text-decoration:none;">Log in</a>
                            </p>
                            @if(Model.Role != "Farmer")
                            {
                                <p style="font-size:13px;color:var(--muted);margin:16px 0 0;">
                                    Are you a local farmer? <a asp-action="Register" asp-route-role="Farmer" style="color:var(--accent);text-decoration:none;">Register as a Seller</a>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
