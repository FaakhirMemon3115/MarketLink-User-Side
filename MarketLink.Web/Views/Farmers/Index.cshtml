@model IEnumerable<MarketLink.Core.Entities.Farmer>
@{
    ViewData["Title"] = "Our Farmers";
}

<div style="background:var(--card);border-bottom:1px solid var(--border);padding:40px 0;">
    <div class="container text-center">
        <h1 style="font-weight:700;color:var(--heading);margin-bottom:16px;">Meet Our Farmers</h1>
        <p style="color:var(--muted);max-width:600px;margin:0 auto;">
            Connect with the people who grow your food. Supporting local agriculture has never been easier.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        @foreach (var f in Model)
        {
            <div class="col-lg-4 col-md-6 animate-on-scroll">
                <div class="card h-100 border-0 shadow-sm" style="border-radius:24px;overflow:hidden;">
                    <div style="height:120px;background:var(--primary);position:relative;">
                        <div style="position:absolute;bottom:-40px;left:50%;transform:translateX(-50%);width:80px;height:80px;background:#fff;border-radius:50%;padding:4px;box-shadow:var(--shadow-sm);">
                            <div style="width:100%;height:100%;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:32px;font-weight:bold;">
                                @(f.FarmName.Substring(0,1))
                            </div>
                        </div>
                    </div>
                    <div class="card-body text-center" style="padding:50px 24px 24px;">
                        <h5 style="font-weight:700;margin-bottom:8px;">@f.FarmName</h5>
                        <div style="font-size:13px;color:var(--muted);margin-bottom:16px;">
                            <i class="fas fa-map-marker-alt text-danger me-1"></i> Local Farm
                        </div>
                        <p style="font-size:14px;color:var(--body-text);margin-bottom:24px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                            @f.Bio
                        </p>
                        <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-green btn-pill px-4">View Profile</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
