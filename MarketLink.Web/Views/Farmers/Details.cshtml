@model MarketLink.Core.Entities.Farmer
@{
    ViewData["Title"] = Model.FarmName;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Farmers</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.FarmName</li>
        </ol>
    </nav>

    <div class="row mb-5">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <div style="width:100px;height:100px;background:var(--primary);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:bold;margin-right:24px;">
                    @(Model.FarmName.Substring(0,1))
                </div>
                <div>
                    <h1 style="font-weight:800;color:var(--heading);margin-bottom:8px;">@Model.FarmName</h1>
                    <div class="d-flex gap-3 text-muted">
                        <span><i class="fas fa-map-marker-alt me-1"></i> Local Farm</span>
                        @if (Model.IsFeatured)
                        {
                            <span class="badge badge-success">Featured</span>
                        }
                    </div>
                </div>
            </div>
            
            <h4 class="mb-3">About the Farm</h4>
            <p style="font-size:1.1rem;color:var(--body-text);line-height:1.6;">
                @Model.Description
            </p>
        </div>
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4" style="border-radius:24px;background:var(--bg);">
                <h5 class="mb-4">Market Information</h5>
                <ul class="list-unstyled mb-4">
                    <li class="mb-3 d-flex align-items-start gap-3">
                        <i class="fas fa-store text-primary mt-1"></i>
                        <div>
                            <strong>Stall Number</strong><br />
                            <span class="text-muted">@(string.IsNullOrEmpty(Model.StallNumber) ? "N/A" : Model.StallNumber)</span>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start gap-3">
                        <i class="fas fa-calendar-alt text-primary mt-1"></i>
                        <div>
                            <strong>Member Since</strong><br />
                            <span class="text-muted">@Model.RegisteredAt.ToString("MMMM yyyy")</span>
                        </div>
                    </li>
                </ul>
                <button class="btn btn-outline-green w-100 btn-pill" onclick="ML.Favorites.toggle('Farmer', @Model.Id, this)">
                    <i class="far fa-heart me-2"></i> Favorite Farmer
                </button>
            </div>
        </div>
    </div>

    <h3 class="mb-4" style="font-weight:800;">Available Products</h3>
    <div class="row g-4">
        @if (ViewBag.Products != null)
        {
            foreach (var p in (IEnumerable<MarketLink.Core.Entities.Product>)ViewBag.Products)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="product-card card h-100 border-0 shadow-sm">
                        <a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none">
                            <div class="product-img-wrapper" style="height:200px;overflow:hidden;">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder.png" : p.ImageUrl)" class="card-img-top" alt="@p.Name" style="height:100%;object-fit:cover;">
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            <a asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none text-dark">
                                <h6 class="card-title fw-bold">@p.Name</h6>
                            </a>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">$@p.PricePerKg.ToString("0.00")/kg</span>
                                <button class="btn btn-sm btn-primary-green btn-circle" onclick="ML.Cart.addItem(@p.Id, 1)" title="Add to Cart">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info border-0 shadow-sm" style="border-radius:12px;">
                    This farmer has no active products at the moment.
                </div>
            </div>
        }
    </div>
</div>
