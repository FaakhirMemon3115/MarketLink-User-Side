<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <circle cx="50" cy="50" r="48" fill="#2E5A27"/>
  <!-- Straw Hat Crown -->
  <path d="M 28 50 Q 28 22 50 22 Q 72 22 72 50 Z" fill="#E9C46A" stroke="#D4A373" stroke-width="2"/>
  <!-- Hat ribbon -->
  <path d="M 28 47 Q 50 49 72 47 L 72 52 Q 50 54 28 52 Z" fill="#264653"/>
  <!-- Hat Brim -->
  <ellipse cx="50" cy="53" rx="36" ry="9" fill="#F4A261" stroke="#D4A373" stroke-width="2"/>
  <!-- Farmer Smile Face outline underneath -->
  <path d="M 38 60 Q 50 78 62 60" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
  <!-- Fresh Leaf Seedling on top -->
  <path d="M 50 22 Q 42 10 50 6 Q 58 10 50 22 Z" fill="#52B788"/>
  <path d="M 50 22 Q 62 14 66 8 Q 62 6 50 22 Z" fill="#74C69D"/>
</svg>
