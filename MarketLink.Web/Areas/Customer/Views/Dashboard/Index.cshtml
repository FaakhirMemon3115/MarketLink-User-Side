@model MarketLink.Core.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container-fluid px-0">
    <!-- Welcome Banner -->
    <div class="card border-0 mb-4" style="background:linear-gradient(135deg, var(--card) 0%, var(--bg) 100%);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
        <div class="card-body p-4 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <span class="badge badge-success mb-2"><i class="fas fa-leaf me-1"></i>Welcome back</span>
                    <h3 class="fw-bold mb-1" style="color:var(--heading);">Hello, @Model.CustomerName!</h3>
                    <p class="text-muted small mb-0">
                        Supporting local growers in @(Model.DefaultCity ?? "your community"). You have <strong>@Model.TotalOrdersCount</strong> orders and <strong>@Model.TotalFavoritesCount</strong> saved favorites.
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-primary-green btn-sm">
                        <i class="fas fa-shopping-basket me-1"></i> Browse Fresh Products
                    </a>
                    <a asp-area="Customer" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-user-edit me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card p-3 border-0 h-100" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="width:40px;height:40px;background:rgba(92,111,43,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:18px;">
                        <i class="fas fa-box"></i>
                    </div>
                    <a asp-area="Customer" asp-controller="Orders" asp-action="History" class="small text-muted text-decoration-none">History &rarr;</a>
                </div>
                <h3 class="fw-bold mb-0" style="color:var(--heading);">@Model.TotalOrdersCount</h3>
                <div class="text-muted small">Total Orders Placed</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card p-3 border-0 h-100" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="width:40px;height:40px;background:rgba(222,128,43,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:18px;">
                        <i class="fas fa-heart"></i>
                    </div>
                    <a asp-area="Customer" asp-controller="Favorites" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                </div>
                <h3 class="fw-bold mb-0" style="color:var(--heading);">@Model.TotalFavoritesCount</h3>
                <div class="text-muted small">Saved Favorites</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card p-3 border-0 h-100" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="width:40px;height:40px;background:rgba(156,171,132,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--primary-dark);font-size:18px;">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <span class="badge badge-success" style="font-size:10px;">Direct</span>
                </div>
                <h3 class="fw-bold mb-0" style="color:var(--heading);">$@Model.TotalSpent.ToString("0.00")</h3>
                <div class="text-muted small">Invested in Local Food</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card p-3 border-0 h-100" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div style="width:40px;height:40px;background:rgba(91,155,213,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#5b9bd5;font-size:18px;">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <a asp-area="Customer" asp-controller="Profile" asp-action="Addresses" class="small text-muted text-decoration-none">Manage &rarr;</a>
                </div>
                <h3 class="fw-bold mb-0" style="color:var(--heading);">@Model.TotalAddressesCount</h3>
                <div class="text-muted small">Saved Addresses</div>
            </div>
        </div>
    </div>

    <!-- Section 1: Browse Products Inside Dashboard -->
    <div class="card border-0 mb-4" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
        <div class="card-header bg-transparent p-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2" style="border-bottom:1px solid var(--border);">
            <div>
                <h5 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-leaf me-2 text-primary-green"></i>Browse Fresh Produce</h5>
                <p class="text-muted small mb-0">Harvested fresh today from approved local farms in your area.</p>
            </div>
            <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-green btn-sm">
                Explore Full Catalog <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-4">
            @if (!Model.Products.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-2">No fresh products currently listed.</p>
                    <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-primary-green btn-sm">Check Marketplace</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var p in Model.Products.Take(4))
                    {
                        bool isSaved = Model.FavoriteProductIds.Contains(p.Id);
                        <div class="col-sm-6 col-lg-3">
                            <div class="card product-card h-100 border-0" style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:var(--transition);">
                                <div style="position:relative;">
                                    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder.png" : p.ImageUrl)" class="card-img-top" alt="@p.Name" style="height:160px;object-fit:cover;">
                                    </a>
                                    @if (p.IsOrganic)
                                    {
                                        <span class="badge badge-success" style="position:absolute;top:8px;left:8px;font-size:10px;">Organic</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-light rounded-circle shadow-sm"
                                            style="position:absolute;top:8px;right:8px;width:30px;height:30px;padding:0;color:@(isSaved ? "#dc3545" : "#6c757d");"
                                            onclick="toggleProductFavorite(this, @p.Id)"
                                            title="Toggle favorite">
                                        <i class="@(isSaved ? "fas fa-heart text-danger" : "far fa-heart")"></i>
                                    </button>
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted" style="font-size:11px;">@p.Category?.Name</span>
                                        <span class="fw-bold text-primary-green" style="font-size:14px;">$@p.PricePerKg.ToString("0.00")<span class="text-muted small">/kg</span></span>
                                    </div>
                                    <h6 class="fw-bold mb-1" style="font-size:14px;">
                                        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@p.Slug" style="color:var(--heading);text-decoration:none;">@p.Name</a>
                                    </h6>
                                    <div class="small text-muted mb-3" style="font-size:11px;">
                                        <i class="fas fa-tractor me-1"></i>@(p.Farmer?.FarmName ?? "Local Farm")
                                    </div>
                                    <div class="mt-auto">
                                        <button class="btn btn-primary-green btn-sm w-100 py-1" onclick="ML.Cart.addItem(@p.Id, 1)" style="font-size:12px;">
                                            <i class="fas fa-shopping-basket me-1"></i>Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Section 2: Recent Orders History & Quick Favorites Widgets -->
    <div class="row g-4">
        <!-- Order History Widget -->
        <div class="col-lg-8">
            <div class="card border-0 h-100" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="card-header bg-transparent p-4 d-flex justify-content-between align-items-center" style="border-bottom:1px solid var(--border);">
                    <div>
                        <h5 class="fw-bold mb-0" style="color:var(--heading);"><i class="fas fa-history me-2 text-primary-green"></i>Recent Order History</h5>
                    </div>
                    <a asp-area="Customer" asp-controller="Orders" asp-action="History" class="btn btn-outline-green btn-sm">
                        View All Orders
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentOrders.Any())
                    {
                        <div class="text-center py-5">
                            <div style="font-size:40px;margin-bottom:12px;">📦</div>
                            <h6 class="fw-bold text-muted">No orders placed yet</h6>
                            <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-primary-green btn-sm">
                                <i class="fas fa-shopping-basket me-1"></i> Start Your First Order
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table mb-0 align-middle" style="font-size:13px;">
                                <thead style="background:var(--bg);">
                                    <tr>
                                        <th class="ps-4 py-3 text-muted fw-semibold">Order #</th>
                                        <th class="py-3 text-muted fw-semibold">Date</th>
                                        <th class="py-3 text-muted fw-semibold">Items</th>
                                        <th class="py-3 text-muted fw-semibold">Total</th>
                                        <th class="py-3 text-muted fw-semibold">Status</th>
                                        <th class="pe-4 py-3 text-end text-muted fw-semibold">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3 fw-bold" style="color:var(--heading);">
                                                #@(string.IsNullOrEmpty(order.OrderNumber) ? order.Id.ToString() : order.OrderNumber)
                                            </td>
                                            <td class="py-3 text-muted">@order.OrderedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="py-3 text-muted">@order.Items.Count item(s)</td>
                                            <td class="py-3 fw-bold text-primary-green">$@order.TotalAmount.ToString("0.00")</td>
                                            <td class="py-3">
                                                @{
                                                    string badge = order.Status switch
                                                    {
                                                        MarketLink.Core.Enums.OrderStatus.Completed => "badge-success",
                                                        MarketLink.Core.Enums.OrderStatus.Cancelled => "badge bg-danger",
                                                        MarketLink.Core.Enums.OrderStatus.ReadyForPickup => "badge bg-info text-white",
                                                        _ => "badge bg-warning text-dark"
                                                    };
                                                }
                                                <span class="badge @badge" style="font-size:11px;">@order.Status</span>
                                            </td>
                                            <td class="pe-4 py-3 text-end">
                                                <a asp-area="Customer" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size:11px;">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Favorites & Shortcuts Widget -->
        <div class="col-lg-4">
            <div class="card border-0 mb-4" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="card-header bg-transparent p-4 d-flex justify-content-between align-items-center" style="border-bottom:1px solid var(--border);">
                    <h6 class="fw-bold mb-0" style="color:var(--heading);"><i class="fas fa-heart me-2 text-danger"></i>Saved Favorites</h6>
                    <a asp-area="Customer" asp-controller="Favorites" asp-action="Index" class="small text-muted text-decoration-none">Manage</a>
                </div>
                <div class="card-body p-4">
                    @if (!Model.Favorites.Any())
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="far fa-heart fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="small mb-2">No saved items yet.</p>
                            <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-green btn-sm w-100">
                                <i class="fas fa-search me-1"></i> Find Produce
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var fav in Model.Favorites.Take(3))
                            {
                                @if (fav.Product != null)
                                {
                                    <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:var(--bg);border:1px solid var(--border);">
                                        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@fav.Product.Slug">
                                            <img src="@(string.IsNullOrEmpty(fav.Product.ImageUrl) ? "/images/placeholder.png" : fav.Product.ImageUrl)" alt="@fav.Product.Name" style="width:44px;height:44px;border-radius:8px;object-fit:cover;" />
                                        </a>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@fav.Product.Slug" class="fw-bold text-truncate d-block" style="font-size:13px;color:var(--heading);text-decoration:none;">@fav.Product.Name</a>
                                            <div class="text-muted" style="font-size:11px;">$@fav.Product.PricePerKg.ToString("0.00")/kg</div>
                                        </div>
                                        <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@fav.Product.Slug" class="btn btn-outline-green btn-sm py-1 px-2" title="View product">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button class="btn btn-primary-green btn-sm py-1 px-2" onclick="ML.Cart.addItem(@fav.Product.Id, 1)" title="Add to cart">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                }
                                else if (fav.Farmer != null)
                                {
                                    <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:var(--bg);border:1px solid var(--border);">
                                        <div style="width:44px;height:44px;border-radius:8px;background:rgba(92,111,43,0.1);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                                            <i class="fas fa-tractor"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-truncate" style="font-size:13px;color:var(--heading);">@fav.Farmer.FarmName</div>
                                            <div class="text-muted" style="font-size:11px;">Local Grower</div>
                                        </div>
                                        <a asp-area="" asp-controller="Farmers" asp-action="Details" asp-route-id="@fav.Farmer.Id" class="btn btn-outline-green btn-sm py-1 px-2" style="font-size:11px;">
                                            View
                                        </a>
                                    </div>
                                }
                            }
                            <a asp-area="Customer" asp-controller="Favorites" asp-action="Index" class="btn btn-light btn-sm text-center fw-semibold text-primary-green mt-1">
                                View All Saved Items (@Model.TotalFavoritesCount)
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Shortcuts Card -->
            <div class="card border-0 mb-4" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color:var(--heading);"><i class="fas fa-compass me-2 text-primary-green"></i>Quick Shortcuts</h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                            <span class="d-flex align-items-center"><i class="fas fa-leaf text-success me-2"></i>Browse Products</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-area="" asp-controller="Markets" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                            <span class="d-flex align-items-center"><i class="fas fa-store text-primary me-2"></i>Explore Markets</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-area="Customer" asp-controller="Orders" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                            <span class="d-flex align-items-center"><i class="fas fa-box text-warning me-2"></i>My Orders</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-area="Customer" asp-controller="Favorites" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                            <span class="d-flex align-items-center"><i class="fas fa-heart text-danger me-2"></i>My Favorites</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-area="Customer" asp-controller="Profile" asp-action="Addresses" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                            <span class="d-flex align-items-center"><i class="fas fa-map-marker-alt text-danger me-2"></i>Saved Addresses</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Eco-impact Card -->
            <div class="card border-0" style="background:linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);color:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);">
                <div class="card-body p-4 text-center">
                    <div style="font-size:32px;margin-bottom:8px;">🌍</div>
                    <h6 class="fw-bold text-white mb-2">Sustainable Food Impact</h6>
                    <p class="small mb-3 opacity-75">Every purchase directly supports regional biodiversity and cuts transit emissions by up to 80%.</p>
                    <a asp-area="" asp-controller="Home" asp-action="About" class="btn btn-light btn-sm fw-bold text-primary px-3 rounded-pill">
                        Our Mission
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function toggleProductFavorite(btn, productId) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('type', 'product');
            formData.append('id', productId);

            const res = await fetch('/Customer/Favorites/Toggle', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });

            if (res.status === 401 || res.redirected) {
                window.location.href = '/Auth/Login';
                return;
            }

            const data = await res.json();
            if (data.success) {
                const icon = btn.querySelector('i');
                if (data.isFavorite) {
                    icon.className = 'fas fa-heart text-danger';
                    btn.style.color = '#dc3545';
                    ML.Toast.show('Saved to your favorites!', 'success');
                } else {
                    icon.className = 'far fa-heart';
                    btn.style.color = '#6c757d';
                    ML.Toast.show('Removed from favorites', 'info');
                }
            }
        } catch (err) {
            ML.Toast.show('Could not update favorites.', 'warning');
        }
    }
</script>
}
