<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – My Account | MarketLink eGreen</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="true">
<div class="dashboard-overlay" id="sidebar-overlay"></div>

<aside class="dashboard-sidebar" id="customer-sidebar">
    <div class="sidebar-brand">
        <h4><i class="fas fa-seedling me-2" style="color:var(--accent)"></i>eGreen<span> Basket</span></h4>
        <p style="font-size:11px;color:var(--muted);margin:4px 0 0">@User.Identity?.Name</p>
    </div>
    <nav class="sidebar-nav">
        <div class="sidebar-section-label">My Account</div>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-home"></i></span> Dashboard
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Profile" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-user-circle"></i></span> My Profile
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Profile" asp-action="Addresses">
            <span class="nav-icon"><i class="fas fa-map-marker-alt"></i></span> Addresses
        </a>

        <div class="sidebar-section-label">Shopping</div>
        <a class="sidebar-nav-item" asp-controller="Products" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-leaf"></i></span> Browse Products
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Cart" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-shopping-basket"></i></span> Shopping Cart
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Favorites" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-heart"></i></span> Favorites
        </a>

        <div class="sidebar-section-label">Orders</div>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Orders" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-box"></i></span> My Orders
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Orders" asp-action="History">
            <span class="nav-icon"><i class="fas fa-history"></i></span> Order History
        </a>

        <div class="sidebar-section-label">Engage</div>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Notifications" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-bell"></i></span> Notifications
            <span class="notif-badge ms-auto" style="position:static;display:none">0</span>
        </a>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Reviews" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-star"></i></span> My Reviews
        </a>

        <div class="sidebar-section-label">Account</div>
        <a class="sidebar-nav-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Settings">
            <span class="nav-icon"><i class="fas fa-cog"></i></span> Settings
        </a>
    </nav>
    <div style="padding:16px 20px;border-top:1px solid var(--border);">
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" style="width:100%;background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px;color:var(--muted);font-size:13px;cursor:pointer;transition:var(--transition);">
                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
            </button>
        </form>
    </div>
</aside>

<div class="dashboard-content">
    <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebar-toggle" class="btn btn-sm" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);">
                <i class="fas fa-bars"></i>
            </button>
            <h6 style="margin:0;font-size:16px;color:var(--heading);">@ViewData["Title"]</h6>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="dark-mode-toggle"></button>
            <a asp-area="Customer" asp-controller="Cart" asp-action="Index" class="nav-icon-btn" style="position:relative;" title="Cart">
                <i class="fas fa-shopping-basket"></i>
                <span class="cart-badge" style="display:none">0</span>
            </a>
            <a asp-area="Customer" asp-controller="Notifications" asp-action="Index" class="nav-icon-btn" style="position:relative;" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" style="display:none">0</span>
            </a>
        </div>
    </header>
    <div class="dashboard-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--success);">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--danger);">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>
<div class="toast-container-green"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
