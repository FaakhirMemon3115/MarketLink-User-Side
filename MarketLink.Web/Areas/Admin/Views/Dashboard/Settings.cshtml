@model IEnumerable<MarketLink.Core.Entities.SiteSetting>
@{
    ViewData["Title"] = "System Settings";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">Marketplace System Settings</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Configure platform-wide options, branding, and operational rules.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Quick Settings Panel -->
    <div class="col-lg-8">
        <div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <div class="card-header" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h6 style="margin:0;font-weight:700;color:var(--heading);">Core Configuration</h6>
            </div>
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="Dashboard" asp-action="SaveSetting" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Setting Key</label>
                            <input type="text" name="key" placeholder="e.g. site_tagline" required class="form-control" style="border:1px solid var(--border);border-radius:var(--radius-sm);" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Value</label>
                            <input type="text" name="value" placeholder="Setting value..." required class="form-control" style="border:1px solid var(--border);border-radius:var(--radius-sm);" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Description (optional)</label>
                            <input type="text" name="description" placeholder="What this setting controls..." class="form-control" style="border:1px solid var(--border);border-radius:var(--radius-sm);" />
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-green btn-pill">
                                <i class="fas fa-save me-2"></i>Save Setting
                            </button>
                        </div>
                    </div>
                </form>

                <hr style="border-color:var(--border);" />

                @if (Model.Any())
                {
                    <h6 style="font-weight:700;color:var(--heading);margin-bottom:12px;">Existing Settings</h6>
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead style="background:var(--bg);">
                                <tr>
                                    <th style="padding:12px 16px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;">Key</th>
                                    <th style="padding:12px 16px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;">Value</th>
                                    <th style="padding:12px 16px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;">Group</th>
                                    <th style="padding:12px 16px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.OrderBy(x => x.Group).ThenBy(x => x.Key))
                                {
                                    <tr>
                                        <td style="padding:12px 16px;font-family:monospace;font-size:12px;color:var(--primary);">@s.Key</td>
                                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:var(--heading);">@s.Value</td>
                                        <td style="padding:12px 16px;">
                                            <span class="badge bg-light text-dark border">@s.Group</span>
                                        </td>
                                        <td style="padding:12px 16px;font-size:12px;color:var(--muted);">@s.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-sliders-h fa-2x mb-2" style="color:var(--border);"></i>
                        <p style="font-size:13px;">No custom settings saved yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Platform Info Sidebar -->
    <div class="col-lg-4">
        <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <h6 style="font-weight:700;color:var(--heading);margin-bottom:16px;">Platform Information</h6>
            <div style="font-size:13px;color:var(--body-text);display:flex;flex-direction:column;gap:10px;">
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--border)!important;">
                    <span class="text-muted">Application</span>
                    <span style="font-weight:700;">MarketLink.eGreen</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--border)!important;">
                    <span class="text-muted">Framework</span>
                    <span>ASP.NET Core 8 MVC</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--border)!important;">
                    <span class="text-muted">Database</span>
                    <span>SQL Server + EF Core</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--border)!important;">
                    <span class="text-muted">Auth</span>
                    <span>ASP.NET Identity</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color:var(--border)!important;">
                    <span class="text-muted">Payment Model</span>
                    <span class="badge bg-warning text-dark">Cash at Pickup</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">Environment</span>
                    <span class="badge bg-success">Production Ready</span>
                </div>
            </div>
        </div>

        <div class="card p-4 mt-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <h6 style="font-weight:700;color:var(--heading);margin-bottom:12px;">Quick Admin Links</h6>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <a asp-area="Admin" asp-controller="Reports" asp-action="ExportOrdersCsv" class="btn btn-outline-success btn-sm btn-pill">
                    <i class="fas fa-download me-1"></i>Export Orders CSV
                </a>
                <a asp-area="Admin" asp-controller="Reports" asp-action="ExportFarmersCsv" class="btn btn-outline-primary btn-sm btn-pill">
                    <i class="fas fa-download me-1"></i>Export Farmers CSV
                </a>
                <a asp-area="Admin" asp-controller="Reports" asp-action="Analytics" class="btn btn-outline-secondary btn-sm btn-pill">
                    <i class="fas fa-chart-line me-1"></i>View Analytics
                </a>
            </div>
        </div>
    </div>
</div>
