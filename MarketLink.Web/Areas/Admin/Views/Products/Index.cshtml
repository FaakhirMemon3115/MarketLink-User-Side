@model IEnumerable<MarketLink.Core.Entities.Product>
@{
    ViewData["Title"] = "Product Moderation";
    var categories = ViewBag.Categories as IEnumerable<MarketLink.Core.Entities.Category> ?? Enumerable.Empty<MarketLink.Core.Entities.Category>();
    var farmers = ViewBag.Farmers as IEnumerable<MarketLink.Core.Entities.Farmer> ?? Enumerable.Empty<MarketLink.Core.Entities.Farmer>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">Marketplace Produce Catalog</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Moderate farm produce items, prices, organic certifications, and listing status.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-primary px-3 py-2" style="font-size:13px;border-radius:var(--radius-sm);">
            Total: @Model.Count() Products Listed
        </span>
    </div>
</div>

<div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-box-open fa-3x mb-3" style="color:var(--border);"></i>
                <h6>No products found matching filters</h6>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead style="background:var(--bg);">
                        <tr>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Produce</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Farmer</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Category</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Price / Unit</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Stock</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Status</th>
                            <th style="padding:16px 20px;border-bottom:none;text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td style="padding:16px 20px;">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" style="width:40px;height:40px;border-radius:8px;object-fit:cover;border:1px solid var(--border);" />
                                        }
                                        <div>
                                            <div style="font-weight:700;color:var(--heading);">@p.Name</div>
                                            @if (p.IsOrganic)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:10px;">Organic</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:600;color:var(--heading);">@(p.Farmer?.FarmName ?? "Unknown Farm")</div>
                                    <div style="font-size:12px;color:var(--muted);">@(p.Farmer?.City ?? "Local")</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge bg-light text-dark border">@(p.Category?.Name ?? "General")</span>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:700;color:var(--heading);">$@p.PricePerKg.ToString("F2")</div>
                                    <div style="font-size:11px;color:var(--muted);">per @p.Unit</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge @(p.StockQuantityKg > 0 ? "bg-light text-dark border" : "bg-danger")">
                                        @p.StockQuantityKg @p.Unit
                                    </span>
                                </td>
                                <td style="padding:16px 20px;">
                                    @if (p.IsAvailable)
                                    {
                                        <span class="badge bg-success">Listed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hidden</span>
                                    }
                                </td>
                                <td style="padding:16px 20px;text-align:right;">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-area="Admin" asp-controller="Products" asp-action="ToggleAvailability" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(p.IsAvailable ? "btn-outline-warning" : "btn-outline-success") btn-pill">
                                                @(p.IsAvailable ? "Hide" : "Show")
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Remove product entirely from marketplace?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-circle" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
