@model IEnumerable<MarketLink.Core.Entities.Order>
@{
    ViewData["Title"] = "All Orders";
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">Marketplace Pre-Orders</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Global log of all pre-orders, pickup windows, and fulfillment across all farms.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success px-3 py-2" style="font-size:13px;border-radius:var(--radius-sm);">
            <i class="fas fa-hand-holding-usd me-1"></i>Volume: $@ViewBag.TotalVolume.ToString("N2")
        </span>
    </div>
</div>

<!-- Status Filters -->
<div class="d-flex flex-wrap gap-2 mb-4 p-2" style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);">
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary-green" : "btn-light") btn-pill">
        All Orders (@Model.Count())
    </a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-primary-green" : "btn-light") btn-pill">
        Pending
    </a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Accepted" class="btn btn-sm @(currentStatus == "Accepted" ? "btn-primary-green" : "btn-light") btn-pill">
        Accepted
    </a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="ReadyForPickup" class="btn btn-sm @(currentStatus == "ReadyForPickup" ? "btn-primary-green" : "btn-light") btn-pill">
        Ready
    </a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Completed" class="btn btn-sm @(currentStatus == "Completed" ? "btn-primary-green" : "btn-light") btn-pill">
        Completed
    </a>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-primary-green" : "btn-light") btn-pill">
        Cancelled
    </a>
</div>

<div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-receipt fa-3x mb-3" style="color:var(--border);"></i>
                <h6>No orders found</h6>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead style="background:var(--bg);">
                        <tr>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Order #</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Customer</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Farmer</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Market / Pickup</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Items</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Total</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            var badgeClass = o.Status switch
                            {
                                MarketLink.Core.Enums.OrderStatus.Pending => "bg-warning text-dark",
                                MarketLink.Core.Enums.OrderStatus.Accepted => "bg-info text-dark",
                                MarketLink.Core.Enums.OrderStatus.ReadyForPickup => "bg-primary text-white",
                                MarketLink.Core.Enums.OrderStatus.Completed => "bg-success text-white",
                                MarketLink.Core.Enums.OrderStatus.Cancelled => "bg-danger text-white",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:700;color:var(--primary);">#@o.OrderNumber</div>
                                    <div style="font-size:11px;color:var(--muted);">@o.OrderedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:600;color:var(--heading);">@(o.Customer?.User?.FullName ?? o.Customer?.User?.UserName ?? "Customer")</div>
                                    <div style="font-size:12px;color:var(--muted);">@o.Customer?.User?.Email</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:600;color:var(--heading);">@(o.Farmer?.FarmName ?? "Farm")</div>
                                    <div style="font-size:12px;color:var(--muted);">@(o.Farmer?.City ?? "Local")</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-size:13px;color:var(--heading);">
                                        <i class="fas fa-store text-muted me-1"></i>@(o.PickupSlot?.Market?.Name ?? "Market Stall")
                                    </div>
                                    <div style="font-size:11px;color:var(--muted);">
                                        @(o.PickupSlot != null ? $"{o.PickupSlot.DayOfWeek} {o.PickupSlot.StartTime:hh\\:mm}" : "Scheduled")
                                    </div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge bg-light text-dark border">
                                        @o.Items.Count items (@o.Items.Sum(i => i.QuantityKg) kg)
                                    </span>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:700;color:var(--heading);">$@o.TotalAmount.ToString("F2")</div>
                                    <div style="font-size:10px;color:var(--accent);font-weight:600;">Cash at Pickup</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge @badgeClass" style="border-radius:var(--radius-sm);font-weight:600;">
                                        @o.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
