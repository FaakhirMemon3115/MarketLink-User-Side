@model IEnumerable<MarketLink.Core.Entities.Category>
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">Produce Categories</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Organize marketplace harvests, dairy, meats, and pantry categories.</p>
    </div>
    <button type="button" class="btn btn-primary-green btn-pill" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="fas fa-plus me-2"></i>Add Category
    </button>
</div>

<div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-tags fa-3x mb-3" style="color:var(--border);"></i>
                <h6>No categories created yet</h6>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead style="background:var(--bg);">
                        <tr>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Category</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Slug</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Description</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Products</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Display Order</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Status</th>
                            <th style="padding:16px 20px;border-bottom:none;text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td style="padding:16px 20px;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width:38px;height:38px;border-radius:8px;background:var(--soft-highlight);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:16px;">
                                            <i class="@c.IconClass"></i>
                                        </div>
                                        <div style="font-weight:700;color:var(--heading);">@c.Name</div>
                                    </div>
                                </td>
                                <td style="padding:16px 20px;font-family:monospace;font-size:12px;color:var(--muted);">
                                    @c.Slug
                                </td>
                                <td style="padding:16px 20px;font-size:13px;color:var(--muted);">
                                    @(c.Description ?? "No description")
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge bg-light text-dark border">
                                        @c.Products.Count products
                                    </span>
                                </td>
                                <td style="padding:16px 20px;font-size:13px;color:var(--heading);">
                                    @c.DisplayOrder
                                </td>
                                <td style="padding:16px 20px;">
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hidden</span>
                                    }
                                </td>
                                <td style="padding:16px 20px;text-align:right;">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-circle" data-bs-toggle="modal" data-bs-target="#editModal-@c.Id" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-circle" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Edit Modal -->
                                    <div class="modal fade" id="editModal-@c.Id" tabindex="-1" aria-hidden="true" style="text-align:left;">
                                        <div class="modal-dialog">
                                            <div class="modal-content" style="border-radius:var(--radius);border:1px solid var(--border);">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" style="font-weight:700;">Edit Category: @c.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@c.Id" />
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label" style="font-weight:600;font-size:13px;">Category Name</label>
                                                            <input type="text" name="name" value="@c.Name" required class="form-control" style="border:1px solid var(--border);" />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label" style="font-weight:600;font-size:13px;">Icon Class</label>
                                                            <input type="text" name="iconClass" value="@c.IconClass" class="form-control" style="border:1px solid var(--border);" />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label" style="font-weight:600;font-size:13px;">Description</label>
                                                            <textarea name="description" rows="2" class="form-control" style="border:1px solid var(--border);">@c.Description</textarea>
                                                        </div>
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-6">
                                                                <label class="form-label" style="font-weight:600;font-size:13px;">Display Order</label>
                                                                <input type="number" name="displayOrder" value="@c.DisplayOrder" class="form-control" style="border:1px solid var(--border);" />
                                                            </div>
                                                            <div class="col-6 d-flex align-items-center pt-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="catActive-@c.Id" @(c.IsActive ? "checked" : "") />
                                                                    <label class="form-check-label" for="catActive-@c.Id">Active</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary-green">Save</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius);border:1px solid var(--border);">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight:700;">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" placeholder="e.g. Organic Dairy" required class="form-control" style="border:1px solid var(--border);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Icon Class</label>
                        <input type="text" name="iconClass" value="fas fa-carrot" class="form-control" style="border:1px solid var(--border);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Description</label>
                        <textarea name="description" rows="2" class="form-control" style="border:1px solid var(--border);"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Display Order</label>
                        <input type="number" name="displayOrder" value="0" class="form-control" style="border:1px solid var(--border);" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-green">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
