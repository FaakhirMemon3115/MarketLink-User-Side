<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MarketLink</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="true">
<div class="dashboard-overlay" id="sidebar-overlay"></div>

@{
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString();
}

<aside class="dashboard-sidebar" id="admin-sidebar">
    <div class="sidebar-brand-fixed" id="sidebar-brand-header">
        <div class="d-flex align-items-center justify-content-between">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link">
                <div class="brand-icon-box">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="brand-text-box">
                    <h4 class="brand-title">MarketLink<span> Admin</span></h4>
                    <p class="brand-user"><i class="fas fa-circle text-success me-1" style="font-size:7px;"></i>@(User.Identity?.Name ?? "Administrator")</p>
                </div>
            </a>
            <button type="button" class="btn btn-sm btn-light d-lg-none rounded-circle" id="sidebar-close-btn" style="width:32px;height:32px;padding:0;display:inline-flex;align-items:center;justify-content:center;" aria-label="Close Sidebar">
                <i class="fas fa-times text-muted"></i>
            </button>
        </div>
    </div>

    <nav class="sidebar-nav">
        <ul class="sidebar-menu-list">
            <li class="sidebar-section-header"><span class="sidebar-section-label">Overview</span></li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Index" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                    <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                    <span class="sidebar-nav-text">Dashboard</span>
                </a>
            </li>

            <li class="sidebar-section-header"><span class="sidebar-section-label">Management</span></li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Farmers" ? "active" : "")" asp-area="Admin" asp-controller="Farmers" asp-action="Index" title="Farmers">
                    <span class="nav-icon"><i class="fas fa-tractor"></i></span>
                    <span class="sidebar-nav-text">Farmers</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Customers" ? "active" : "")" asp-area="Admin" asp-controller="Customers" asp-action="Index" title="Customers">
                    <span class="nav-icon"><i class="fas fa-users"></i></span>
                    <span class="sidebar-nav-text">Customers</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index" title="Products">
                    <span class="nav-icon"><i class="fas fa-leaf"></i></span>
                    <span class="sidebar-nav-text">Products</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index" title="Categories">
                    <span class="nav-icon"><i class="fas fa-tags"></i></span>
                    <span class="sidebar-nav-text">Categories</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Markets" ? "active" : "")" asp-area="Admin" asp-controller="Markets" asp-action="Index" title="Markets">
                    <span class="nav-icon"><i class="fas fa-store"></i></span>
                    <span class="sidebar-nav-text">Markets</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index" title="Orders">
                    <span class="nav-icon"><i class="fas fa-shopping-cart"></i></span>
                    <span class="sidebar-nav-text">Orders</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Reviews" ? "active" : "")" asp-area="Admin" asp-controller="Reviews" asp-action="Index" title="Reviews">
                    <span class="nav-icon"><i class="fas fa-star"></i></span>
                    <span class="sidebar-nav-text">Reviews</span>
                </a>
            </li>

            <li class="sidebar-section-header"><span class="sidebar-section-label">Analytics</span></li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Reports" && currentAct == "Index" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index" title="Reports">
                    <span class="nav-icon"><i class="fas fa-chart-bar"></i></span>
                    <span class="sidebar-nav-text">Reports</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Reports" && currentAct == "Analytics" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Analytics" title="Analytics">
                    <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="sidebar-nav-text">Analytics</span>
                </a>
            </li>

            <li class="sidebar-section-header"><span class="sidebar-section-label">System</span></li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Notifications" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Notifications" title="Notifications">
                    <span class="nav-icon"><i class="fas fa-bell"></i></span>
                    <span class="sidebar-nav-text">Notifications</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Settings" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Settings" title="Settings">
                    <span class="nav-icon"><i class="fas fa-cog"></i></span>
                    <span class="sidebar-nav-text">Settings</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item" asp-area="" asp-controller="Home" asp-action="Index" title="View Storefront">
                    <span class="nav-icon"><i class="fas fa-external-link-alt"></i></span>
                    <span class="sidebar-nav-text">View Storefront</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-footer-fixed">
        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="w-100">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-signout-btn" title="Sign Out">
                <i class="fas fa-sign-out-alt"></i>
                <span class="sidebar-nav-text">Sign Out</span>
            </button>
        </form>
    </div>
</aside>

<div class="dashboard-content">
    <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebar-toggle" class="btn btn-sm btn-sidebar-toggle" title="Toggle Sidebar" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
            <div>
                <h6 class="topbar-title">@ViewData["Title"]</h6>
                @if (ViewData["Subtitle"] != null)
                {
                    <p class="mb-0" style="font-size:12px;color:var(--muted);">@ViewData["Subtitle"]</p>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 gap-sm-3">
            <button class="dark-mode-toggle" title="Toggle dark mode" aria-label="Toggle dark mode"></button>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="nav-icon-btn" title="Product Catalog">
                <i class="fas fa-leaf"></i>
            </a>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Notifications" class="nav-icon-btn" style="position:relative;" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" style="display:none">0</span>
            </a>
            <div class="dropdown">
                <button class="nav-icon-btn" data-bs-toggle="dropdown" aria-label="Account">
                    <i class="fas fa-user-shield"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="border:1px solid var(--border);border-radius:var(--radius);min-width:200px;">
                    <li><h6 class="dropdown-header">@(User.Identity?.Name ?? "Administrator")</h6></li>
                    <li><a class="dropdown-item small" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-tachometer-alt me-2 text-primary-green"></i>Dashboard</a></li>
                    <li><a class="dropdown-item small" asp-area="Admin" asp-controller="Dashboard" asp-action="Settings"><i class="fas fa-cog me-2 text-muted"></i>Settings</a></li>
                    <li><a class="dropdown-item small" asp-area="Admin" asp-controller="Dashboard" asp-action="Notifications"><i class="fas fa-bell me-2 text-info"></i>Notifications</a></li>
                    <li><a class="dropdown-item small" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-store me-2 text-muted"></i>Storefront</a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item small text-danger"><i class="fas fa-sign-out-alt me-2"></i>Sign Out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main class="dashboard-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success auto-dismiss alert-dismissible fade show" role="alert" style="border-radius:var(--radius-sm);border-left:4px solid var(--success);">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger auto-dismiss alert-dismissible fade show" role="alert" style="border-radius:var(--radius-sm);border-left:4px solid var(--danger);">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
</div>

<div class="toast-container-green"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
