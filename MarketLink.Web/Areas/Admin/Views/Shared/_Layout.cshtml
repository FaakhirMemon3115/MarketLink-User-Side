<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Admin Panel | MarketLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="true">
<div class="dashboard-overlay" id="sidebar-overlay"></div>

<!-- Admin Sidebar -->
<aside class="dashboard-sidebar" id="admin-sidebar">
    <div class="sidebar-brand">
        <h4><i class="fas fa-shield-alt me-2" style="color:var(--accent)"></i>MarketLink<span>.</span>Admin</h4>
        <p style="font-size:11px;color:var(--muted);margin:4px 0 0">Administration Panel</p>
    </div>
    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Overview</div>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span> Dashboard
        </a>

        <div class="sidebar-section-label">Management</div>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Farmers" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-tractor"></i></span> Farmers
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Customers" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-users"></i></span> Customers
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Products" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-box"></i></span> Products
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-tags"></i></span> Categories
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Markets" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-store"></i></span> Markets
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Orders" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-shopping-cart"></i></span> Orders
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-star"></i></span> Reviews
        </a>

        <div class="sidebar-section-label">Analytics</div>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Reports" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-chart-bar"></i></span> Reports
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Reports" asp-action="Analytics">
            <span class="nav-icon"><i class="fas fa-chart-line"></i></span> Analytics
        </a>

        <div class="sidebar-section-label">System</div>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Notifications">
            <span class="nav-icon"><i class="fas fa-bell"></i></span> Notifications
        </a>
        <a class="sidebar-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Settings">
            <span class="nav-icon"><i class="fas fa-cog"></i></span> Settings
        </a>
        <a class="sidebar-nav-item" asp-controller="Home" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-external-link-alt"></i></span> View Site
        </a>
    </nav>
    <div style="padding:16px 20px;border-top:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:36px;height:36px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;">A</div>
            <div>
                <div style="font-size:13px;font-weight:700;color:var(--heading);">Administrator</div>
                <div style="font-size:11px;color:var(--muted);">System Admin</div>
            </div>
        </div>
    </div>
</aside>

<!-- Dashboard Content -->
<div class="dashboard-content">
    <!-- Top Bar -->
    <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebar-toggle" class="btn btn-sm" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);">
                <i class="fas fa-bars" style="color:var(--heading)"></i>
            </button>
            <div>
                <h6 style="margin:0;font-size:16px;color:var(--heading);">@ViewData["Title"]</h6>
                @if (ViewData["Subtitle"] != null)
                {
                    <p style="margin:0;font-size:12px;color:var(--muted);">@ViewData["Subtitle"]</p>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="dark-mode-toggle" aria-label="Toggle dark mode"></button>
            <a href="#" class="nav-icon-btn" style="position:relative;" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" style="display:none">0</span>
            </a>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--body-text);">
                    <i class="fas fa-sign-out-alt me-1"></i>Logout
                </button>
            </form>
        </div>
    </header>

    <!-- Page Content -->
    <div class="dashboard-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--success);">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--danger);">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<div class="toast-container-green"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
