<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Farmer Dashboard | MarketLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="true">
<div class="dashboard-overlay" id="sidebar-overlay"></div>

<aside class="dashboard-sidebar" id="farmer-sidebar">
    <div class="sidebar-brand">
        <h4><i class="fas fa-tractor me-2" style="color:var(--accent)"></i>Farmer<span> Hub</span></h4>
        <p style="font-size:11px;color:var(--muted);margin:4px 0 0">@User.Identity?.Name</p>
    </div>
    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Overview</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Dashboard" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-home"></i></span> Dashboard
        </a>

        <div class="sidebar-section-label">Farm</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Profile" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-user-circle"></i></span> My Profile
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Profile" asp-action="Markets">
            <span class="nav-icon"><i class="fas fa-store"></i></span> My Markets
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-clock"></i></span> Pickup Slots
        </a>

        <div class="sidebar-section-label">Products</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Products" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-box-open"></i></span> My Products
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Products" asp-action="Create">
            <span class="nav-icon"><i class="fas fa-plus-circle"></i></span> Add Product
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Inventory" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-warehouse"></i></span> Inventory
        </a>

        <div class="sidebar-section-label">Orders</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Orders" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-shopping-cart"></i></span> Orders
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Orders" asp-action="Index" asp-route-status="Pending">
            <span class="nav-icon"><i class="fas fa-clock"></i></span> Pending Orders
        </a>

        <div class="sidebar-section-label">Insights</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Analytics" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-chart-line"></i></span> Analytics
        </a>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Reviews" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-star"></i></span> Reviews
        </a>

        <div class="sidebar-section-label">Account</div>
        <a class="sidebar-nav-item" asp-area="Farmer" asp-controller="Dashboard" asp-action="Settings">
            <span class="nav-icon"><i class="fas fa-cog"></i></span> Settings
        </a>
        <a class="sidebar-nav-item" asp-controller="Home" asp-action="Index">
            <span class="nav-icon"><i class="fas fa-globe"></i></span> View Marketplace
        </a>
    </nav>
    <div style="padding:16px 20px;border-top:1px solid var(--border);">
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" style="width:100%;background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px;color:var(--muted);font-size:13px;cursor:pointer;transition:var(--transition);">
                <i class="fas fa-sign-out-alt me-2"></i>Sign Out
            </button>
        </form>
    </div>
</aside>

<div class="dashboard-content">
    <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebar-toggle" class="btn btn-sm" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);">
                <i class="fas fa-bars" style="color:var(--heading)"></i>
            </button>
            <div>
                <h6 style="margin:0;font-size:16px;color:var(--heading);">@ViewData["Title"]</h6>
                @if (ViewData["Subtitle"] != null)
                {
                    <p style="margin:0;font-size:12px;color:var(--muted);">@ViewData["Subtitle"]</p>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="dark-mode-toggle"></button>
            <a asp-area="Farmer" asp-controller="Orders" asp-action="Index" asp-route-status="Pending" class="nav-icon-btn" style="position:relative;" title="Pending Orders">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" style="display:none">0</span>
            </a>
        </div>
    </header>
    <div class="dashboard-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--success);">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--danger);">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>
<div class="toast-container-green"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
