@model MarketLink.Core.Entities.Product
@{
    ViewData["Title"] = $"Edit {Model.Name}";
    var categories = ViewBag.Categories as IEnumerable<MarketLink.Core.Entities.Category> ?? Enumerable.Empty<MarketLink.Core.Entities.Category>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <div>
                    <h5 style="margin:0;font-weight:700;color:var(--heading);">
                        <i class="fas fa-edit me-2" style="color:var(--accent)"></i>Edit Produce: @Model.Name
                    </h5>
                    <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Update produce pricing, availability, and stock details.</p>
                </div>
                <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm btn-pill">
                    <i class="fas fa-arrow-left me-1"></i>Back to Catalog
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-area="Farmer" asp-controller="Products" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FarmerId" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Produce Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" required style="border-radius:var(--radius-sm);border:1px solid var(--border);" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select" style="border-radius:var(--radius-sm);border:1px solid var(--border);">
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" style="border-radius:var(--radius-sm);border:1px solid var(--border);"></textarea>
                            <span asp-validation-for="Description" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PricePerKg" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:var(--bg);border:1px solid var(--border);">$</span>
                                <input asp-for="PricePerKg" type="number" step="0.01" min="0.01" class="form-control" required style="border:1px solid var(--border);" />
                            </div>
                            <span asp-validation-for="PricePerKg" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Unit" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Unit</label>
                            <select asp-for="Unit" class="form-select" style="border-radius:var(--radius-sm);border:1px solid var(--border);">
                                <option value="KG">Kilogram (KG)</option>
                                <option value="Bunch">Bunch</option>
                                <option value="Box">Box / Basket</option>
                                <option value="Piece">Piece / Item</option>
                                <option value="Dozen">Dozen</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StockQuantityKg" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Stock Quantity <span class="text-danger">*</span></label>
                            <input asp-for="StockQuantityKg" type="number" min="0" class="form-control" required style="border-radius:var(--radius-sm);border:1px solid var(--border);" />
                            <span asp-validation-for="StockQuantityKg" class="text-danger" style="font-size:12px;"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Season" class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Harvest Season</label>
                            <select asp-for="Season" class="form-select" style="border-radius:var(--radius-sm);border:1px solid var(--border);">
                                <option value="All Season">All Season</option>
                                <option value="Summer">Summer</option>
                                <option value="Fall">Fall</option>
                                <option value="Winter">Winter</option>
                                <option value="Spring">Spring</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" style="font-weight:600;font-size:13px;color:var(--heading);">Produce Image URL</label>
                            <input type="url" name="imageUrl" value="@Model.ImageUrl" class="form-control" placeholder="https://..." style="border-radius:var(--radius-sm);border:1px solid var(--border);" />
                        </div>

                        <div class="col-12 pt-2">
                            <div class="d-flex flex-wrap gap-4 p-3" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);">
                                <div class="form-check form-switch">
                                    <input asp-for="IsOrganic" class="form-check-input" type="checkbox" id="editOrganicSwitch" />
                                    <label class="form-check-label" for="editOrganicSwitch" style="font-weight:600;font-size:13px;color:var(--heading);">
                                        <i class="fas fa-leaf text-success me-1"></i> Certified Organic
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" id="editAvailableSwitch" />
                                    <label class="form-check-label" for="editAvailableSwitch" style="font-weight:600;font-size:13px;color:var(--heading);">
                                        <i class="fas fa-check text-primary me-1"></i> Available for Order
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-between align-items-center pt-3">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="if(confirm('Are you sure you want to delete this produce?')) document.getElementById('deleteForm').submit();">
                                <i class="fas fa-trash me-1"></i>Delete Produce
                            </button>
                            <div class="d-flex gap-2">
                                <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="btn btn-light px-4" style="border:1px solid var(--border);border-radius:var(--radius-sm);">Cancel</a>
                                <button type="submit" class="btn btn-primary-green px-4 btn-pill">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <form id="deleteForm" asp-area="Farmer" asp-controller="Products" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
</div>
