                <span class="text-muted">Account Type</span>
                <span class="badge bg-success">Farmer</span>
            </div>

            <div class="d-flex justify-content-between py-2 border-bottom"
                 style="border-color:var(--border)!important;">
                <span class="text-muted">Marketplace</span>
                <span style="font-weight:700;">MarketLink</span>
            </div>

            <div class="d-flex justify-content-between py-2 border-bottom"
                 style="border-color:var(--border)!important;">
                <span class="text-muted">Role</span>
                <span>Farmer</span>
            </div>

            <div class="d-flex justify-content-between py-2 border-bottom"
                 style="border-color:var(--border)!important;">
                <span class="text-muted">Order Payment</span>
                <span class="badge bg-warning text-dark">
                    Cash at Pickup
                </span>
            </div>

            <div class="d-flex justify-content-between py-2">
                <span class="text-muted">Account Status</span>
                <span class="badge bg-success">
                    Active
                </span>
            </div>

        </div>
    </div>


    <!-- Farmer Quick Links -->
    <div class="card p-4 mt-4"
         style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">

        <h6 style="font-weight:700;color:var(--heading);margin-bottom:12px;">
            Quick Links
        </h6>

        <div style="display:flex;flex-direction:column;gap:8px;">

            <a asp-area="Farmer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-success btn-sm btn-pill">
                <i class="fas fa-box me-1"></i>
                My Products
            </a>

            <a asp-area="Farmer"
               asp-controller="Orders"
               asp-action="Index"
               class="btn btn-outline-primary btn-sm btn-pill">
                <i class="fas fa-shopping-cart me-1"></i>
                My Orders
            </a>

            <a asp-area="Farmer"
               asp-controller="Dashboard"
               asp-action="Profile"
               class="btn btn-outline-secondary btn-sm btn-pill">
                <i class="fas fa-user me-1"></i>
                My Profile
            </a>

        </div>
    </div>

</div>
