@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="width:40px;height:40px;background:var(--soft-highlight);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-shopping-cart text-primary" style="font-size:20px;"></i>
                </div>
                <span class="badge badge-warning">3 Pending</span>
            </div>
            <h3 style="font-weight:700;margin:0;">15</h3>
            <div style="font-size:14px;color:var(--muted);margin-top:4px;">New Orders Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="width:40px;height:40px;background:rgba(216,233,131,0.2);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-dollar-sign text-success" style="font-size:20px;"></i>
                </div>
            </div>
            <h3 style="font-weight:700;margin:0;">$450.00</h3>
            <div style="font-size:14px;color:var(--muted);margin-top:4px;">Revenue Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="width:40px;height:40px;background:rgba(222,128,43,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-box text-accent" style="font-size:20px;"></i>
                </div>
            </div>
            <h3 style="font-weight:700;margin:0;">@ViewBag.ProductCount</h3>
            <div style="font-size:14px;color:var(--muted);margin-top:4px;">Active Products</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="width:40px;height:40px;background:rgba(220,53,69,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-exclamation-triangle text-danger" style="font-size:20px;"></i>
                </div>
            </div>
            <h3 style="font-weight:700;margin:0;color:var(--danger)">@ViewBag.LowStockCount</h3>
            <div style="font-size:14px;color:var(--muted);margin-top:4px;">Low Stock Alerts</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="card-header" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h6 style="margin:0;font-weight:700;">Sales Overview</h6>
            </div>
            <div class="card-body p-4">
                <canvas id="farmerSalesChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="card-header" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h6 style="margin:0;font-weight:700;">Upcoming Pickups</h6>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <div class="list-group-item" style="padding:16px 20px;border-bottom:1px solid var(--border);background:transparent;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 style="margin:0;font-weight:600;">Downtown Market</h6>
                            <span class="badge badge-info">10:00 AM</span>
                        </div>
                        <div style="font-size:13px;color:var(--muted);">Order #ORD-1002 (3 items)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            ML.initSalesChart('farmerSalesChart', ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], [150, 230, 180, 320, 290, 450, 380]);
        });
    </script>
}
