@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="mb-1" style="font-weight:700;color:var(--heading);">Farm Operations</h4>
        <p class="mb-0" style="font-size:13px;color:var(--muted);">Track listings, pickup demand, and inventory health in one place.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Farmer" asp-controller="Products" asp-action="Create" class="btn btn-primary-green btn-sm">
            <i class="fas fa-plus me-1"></i> Add Product
        </a>
        <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-box-open me-1"></i> My Products
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
        <a asp-area="Farmer" asp-controller="Orders" asp-action="Index" class="dash-stat-card">
            <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width:40px;height:40px;background:var(--soft-highlight);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-shopping-cart text-primary" style="font-size:20px;"></i>
                    </div>
                    <span class="small text-muted">View &rarr;</span>
                </div>
                <h3 style="font-weight:700;margin:0;">@(ViewBag.TotalOrdersCount ?? 0)</h3>
                <div style="font-size:14px;color:var(--muted);margin-top:4px;">All Orders</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Farmer" asp-controller="Orders" asp-action="Index" asp-route-status="Pending" class="dash-stat-card">
            <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width:40px;height:40px;background:rgba(216,233,131,0.2);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-hourglass-half text-success" style="font-size:20px;"></i>
                    </div>
                    <span class="badge badge-warning">Pending</span>
                </div>
                <h3 style="font-weight:700;margin:0;">@(ViewBag.PendingOrdersCount ?? 0)</h3>
                <div style="font-size:14px;color:var(--muted);margin-top:4px;">Pending Orders</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="dash-stat-card">
            <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width:40px;height:40px;background:rgba(222,128,43,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-box text-accent" style="font-size:20px;"></i>
                    </div>
                    <span class="small text-muted">View &rarr;</span>
                </div>
                <h3 style="font-weight:700;margin:0;">@(ViewBag.ProductCount ?? 0)</h3>
                <div style="font-size:14px;color:var(--muted);margin-top:4px;">Active Products</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-area="Farmer" asp-controller="Inventory" asp-action="Index" class="dash-stat-card">
            <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div style="width:40px;height:40px;background:rgba(220,53,69,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-exclamation-triangle text-danger" style="font-size:20px;"></i>
                    </div>
                    <span class="small text-muted">Restock &rarr;</span>
                </div>
                <h3 style="font-weight:700;margin:0;color:var(--danger)">@(ViewBag.LowStockCount ?? 0)</h3>
                <div style="font-size:14px;color:var(--muted);margin-top:4px;">Low Stock Alerts</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h6 style="margin:0;font-weight:700;">Sales Overview</h6>
                <a asp-area="Farmer" asp-controller="Analytics" asp-action="Index" class="small text-muted text-decoration-none">Analytics &rarr;</a>
            </div>
            <div class="card-body p-4">
                <canvas id="farmerSalesChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h6 style="margin:0;font-weight:700;">Pickup Schedule</h6>
                <a asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index" class="small text-muted text-decoration-none">Manage &rarr;</a>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">Keep stall windows current so customers can complete pickup orders on time.</p>
                <a asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index" class="btn btn-outline-green btn-sm w-100 mb-2">
                    <i class="fas fa-clock me-1"></i> Pickup Slots
                </a>
                <a asp-area="Farmer" asp-controller="Profile" asp-action="Markets" class="btn btn-light btn-sm w-100" style="border:1px solid var(--border);">
                    <i class="fas fa-store me-1"></i> Linked Markets
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
    <div class="card-header" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
        <h6 class="mb-0" style="font-weight:700;">Catalog Shortcuts</h6>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="btn btn-light w-100 text-start py-3" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                    <i class="fas fa-leaf text-success me-2"></i> My Products
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a asp-area="Farmer" asp-controller="Products" asp-action="Create" class="btn btn-light w-100 text-start py-3" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                    <i class="fas fa-plus-circle text-primary me-2"></i> Add Product
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a asp-area="Farmer" asp-controller="Inventory" asp-action="Index" class="btn btn-light w-100 text-start py-3" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                    <i class="fas fa-warehouse text-warning me-2"></i> Inventory
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a asp-area="Farmer" asp-controller="Dashboard" asp-action="Settings" class="btn btn-light w-100 text-start py-3" style="border:1px solid var(--border);border-radius:var(--radius-sm);">
                    <i class="fas fa-cog text-muted me-2"></i> Settings
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            ML.initSalesChart('farmerSalesChart', ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], [150, 230, 180, 320, 290, 450, 380]);
        });
    </script>
}
