@{
    ViewData["Title"] = "Account Settings";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="mb-1" style="font-weight:700;color:var(--heading);">Farm Account Settings</h4>
        <p class="mb-0" style="font-size:13px;color:var(--muted);">Manage profile, stall locations, catalog, and session controls.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-4">
        <a asp-area="Farmer" asp-controller="Profile" asp-action="Index" class="dash-stat-card">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(92,111,43,.12);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Farm Profile</h6>
                </div>
                <p class="small text-muted mb-0">Update farm name, contact details, and public story.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a asp-area="Farmer" asp-controller="Profile" asp-action="Markets" class="dash-stat-card">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(92,111,43,.12);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                        <i class="fas fa-store"></i>
                    </div>
                    <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Linked Markets</h6>
                </div>
                <p class="small text-muted mb-0">Choose which markets your stall appears in.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index" class="dash-stat-card">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(92,111,43,.12);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Pickup Windows</h6>
                </div>
                <p class="small text-muted mb-0">Set customer pickup hours for each stall.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="dash-stat-card">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(92,111,43,.12);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Product Catalog</h6>
                </div>
                <p class="small text-muted mb-0">Edit prices, availability, and produce listings.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a asp-area="Farmer" asp-controller="Inventory" asp-action="Index" class="dash-stat-card">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div style="width:42px;height:42px;border-radius:10px;background:rgba(92,111,43,.12);display:flex;align-items:center;justify-content:center;color:var(--primary);">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Inventory</h6>
                </div>
                <p class="small text-muted mb-0">Restock items and review low-inventory alerts.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="card p-4 h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:42px;height:42px;border-radius:10px;background:rgba(220,53,69,.1);display:flex;align-items:center;justify-content:center;color:#dc3545;">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <h6 class="mb-0" style="font-weight:700;color:var(--heading);">Session</h6>
            </div>
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="fas fa-sign-out-alt me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </div>
</div>
