@model MarketLink.Core.Entities.Farmer
@{
    ViewData["Title"] = "Account Settings";
    var appUser = ViewBag.User as MarketLink.Core.Entities.ApplicationUser;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="mb-1" style="font-weight:700;color:var(--heading);"><i class="fas fa-cog me-2 text-primary-green"></i>Farm Account Settings</h4>
        <p class="mb-0" style="font-size:13px;color:var(--muted);">Manage your farm profile details, market stall info, security, and shortcuts.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Farm Details & Stall Settings -->
    <div class="col-lg-7">
        <div class="card p-4 border-0 mb-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <div class="d-flex align-items-center gap-3 mb-3 pb-2 border-bottom">
                <div style="width:42px;height:42px;border-radius:10px;background:rgba(46,90,39,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:18px;">
                    <i class="fas fa-tractor"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold" style="color:var(--heading);">Farm Profile & Stall Setup</h6>
                    <small class="text-muted">Visible to buyers browsing the local marketplace</small>
                </div>
            </div>

            <form asp-area="Farmer" asp-controller="Dashboard" asp-action="UpdateSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Farm / Brand Name</label>
                    <input type="text" name="farmName" class="form-control form-control-sm" value="@Model.FarmName" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">About Your Farm (Story / Methods)</label>
                    <textarea name="description" class="form-control form-control-sm" rows="3">@Model.Description</textarea>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Contact Phone</label>
                        <input type="tel" name="phone" class="form-control form-control-sm" value="@Model.Phone" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Market Stall #</label>
                        <input type="text" name="stallNumber" class="form-control form-control-sm" value="@Model.StallNumber" placeholder="e.g. Stall #14" />
                    </div>
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">City</label>
                        <input type="text" name="city" class="form-control form-control-sm" value="@Model.City" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">State / Region</label>
                        <input type="text" name="state" class="form-control form-control-sm" value="@Model.State" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary-green btn-sm px-4">
                    <i class="fas fa-save me-1"></i> Save Farm Profile
                </button>
            </form>
        </div>

        <!-- Security & Password -->
        <div class="card p-4 border-0" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <div class="d-flex align-items-center gap-3 mb-3 pb-2 border-bottom">
                <div style="width:42px;height:42px;border-radius:10px;background:rgba(222,128,43,0.12);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:18px;">
                    <i class="fas fa-lock"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold" style="color:var(--heading);">Security & Password</h6>
                    <small class="text-muted">Update your login password regularly</small>
                </div>
            </div>

            <form asp-area="Farmer" asp-controller="Dashboard" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Current Password</label>
                    <input type="password" name="currentPassword" class="form-control form-control-sm" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">New Password</label>
                        <input type="password" name="newPassword" class="form-control form-control-sm" required minlength="8" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control form-control-sm" required minlength="8" />
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-green btn-sm px-4">
                    <i class="fas fa-key me-1"></i> Update Password
                </button>
            </form>
        </div>
    </div>

    <!-- Quick Shortcuts & Session -->
    <div class="col-lg-5">
        <div class="card p-4 border-0 mb-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <h6 class="fw-bold mb-3" style="color:var(--heading);"><i class="fas fa-link me-2 text-primary-green"></i>Direct Management Links</h6>
            <div class="d-flex flex-column gap-2">
                <a asp-area="Farmer" asp-controller="Notifications" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);">
                    <span><i class="fas fa-bell text-warning me-2"></i>Farm Notifications</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Farmer" asp-controller="Profile" asp-action="Markets" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);">
                    <span><i class="fas fa-store text-primary-green me-2"></i>Linked Markets</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);">
                    <span><i class="fas fa-clock text-info me-2"></i>Stall Pickup Windows</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Farmer" asp-controller="Inventory" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);">
                    <span><i class="fas fa-warehouse text-success me-2"></i>Stock & Inventory</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
                <a asp-area="Farmer" asp-controller="Products" asp-action="Index" class="btn btn-light btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between" style="border:1px solid var(--border);">
                    <span><i class="fas fa-leaf text-success me-2"></i>Manage Produce Listings</span>
                    <i class="fas fa-chevron-right text-muted small"></i>
                </a>
            </div>
        </div>

        <div class="card p-4 border-0" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:42px;height:42px;border-radius:10px;background:rgba(220,53,69,0.1);display:flex;align-items:center;justify-content:center;color:#dc3545;">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold" style="color:var(--heading);">Active Session</h6>
                    <small class="text-muted">Signed in as @(User.Identity?.Name ?? "Farmer")</small>
                </div>
            </div>
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="fas fa-sign-out-alt me-1"></i> Sign Out of Farm Hub
                </button>
            </form>
        </div>
    </div>
</div>
