@model MarketLink.Core.Entities.Farmer
@{
    ViewData["Title"] = "My Markets";
    var allMarkets = ViewBag.AllMarkets as IEnumerable<MarketLink.Core.Entities.Market> ?? Enumerable.Empty<MarketLink.Core.Entities.Market>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">My Associated Markets</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Select the local farmers markets where you sell produce and set up stalls.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Farmer" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm btn-pill">
            <i class="fas fa-arrow-left me-1"></i>Farm Profile
        </a>
        <button type="button" class="btn btn-primary-green btn-pill" data-bs-toggle="modal" data-bs-target="#linkMarketModal">
            <i class="fas fa-plus me-1"></i>Link New Market
        </button>
    </div>
</div>

<div class="row g-4">
    @if (!Model.FarmerMarkets.Any())
    {
        <div class="col-12">
            <div class="card p-5 text-center" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <i class="fas fa-store-slash fa-3x mb-3" style="color:var(--border);"></i>
                <h6 style="color:var(--heading);">No markets linked yet</h6>
                <p style="font-size:13px;color:var(--muted);">Link your farm to markets so customers can discover you by market location.</p>
                <div>
                    <button type="button" class="btn btn-primary-green btn-sm btn-pill" data-bs-toggle="modal" data-bs-target="#linkMarketModal">
                        <i class="fas fa-plus me-1"></i>Link Market
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var fm in Model.FarmerMarkets)
        {
            <div class="col-md-6">
                <div class="card h-100" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 style="margin:0;font-weight:700;color:var(--heading);">@fm.Market.Name</h5>
                                <div style="font-size:13px;color:var(--muted);margin-top:2px;">
                                    <i class="fas fa-map-marker-alt text-danger me-1"></i>@fm.Market.Address, @fm.Market.City, @fm.Market.State
                                </div>
                            </div>
                            <span class="badge bg-success">Linked</span>
                        </div>

                        <div class="p-3 mb-3" style="background:var(--bg);border-radius:var(--radius-sm);border:1px solid var(--border);font-size:13px;">
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Your Stall #:</span>
                                <span style="font-weight:700;color:var(--heading);">@(string.IsNullOrEmpty(fm.StallNumber) ? "Main Pavillion" : fm.StallNumber)</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Market Hours:</span>
                                <span>@(fm.Market.OperatingHours ?? "Saturdays 8 AM - 1 PM")</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <form asp-area="Farmer" asp-controller="Profile" asp-action="RemoveMarket" asp-route-id="@fm.Id" method="post" onsubmit="return confirm('Remove market link?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm btn-pill">
                                    <i class="fas fa-unlink me-1"></i>Unlink Market
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Link Market Modal -->
<div class="modal fade" id="linkMarketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius);border:1px solid var(--border);">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight:700;">Link Market to Farm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Farmer" asp-controller="Profile" asp-action="AddMarket" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Choose Market <span class="text-danger">*</span></label>
                        <select name="marketId" class="form-select" required style="border:1px solid var(--border);">
                            @foreach (var m in allMarkets)
                            {
                                <option value="@m.Id">@m.Name (@m.City, @m.State)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600;font-size:13px;">Stall / Booth Number</label>
                        <input type="text" name="stallNumber" placeholder="e.g. Stall B-04" class="form-control" style="border:1px solid var(--border);" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-green">Link Market</button>
                </div>
            </form>
        </div>
    </div>
</div>
