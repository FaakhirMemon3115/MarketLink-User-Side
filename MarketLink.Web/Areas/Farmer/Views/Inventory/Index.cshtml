@model IEnumerable<MarketLink.Core.Entities.Product>
@{
    ViewData["Title"] = "Weekly Inventory Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);">Weekly Stock & Harvest Controls</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Rapidly adjust stock levels, restock harvest batches, and toggle availability.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-danger d-flex align-items-center px-3 py-2" style="font-size:13px;border-radius:var(--radius-sm);">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.LowStockCount Low Stock
        </span>
        <span class="badge bg-secondary d-flex align-items-center px-3 py-2" style="font-size:13px;border-radius:var(--radius-sm);">
            <i class="fas fa-ban me-2"></i>@ViewBag.OutOfStockCount Sold Out / Inactive
        </span>
    </div>
</div>

<div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-boxes fa-3x mb-3" style="color:var(--border);"></i>
                <h6 style="color:var(--heading);">No produce in your inventory</h6>
                <a asp-area="Farmer" asp-controller="Products" asp-action="Create" class="btn btn-primary-green btn-sm btn-pill mt-2">
                    <i class="fas fa-plus me-1"></i>Add Produce
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead style="background:var(--bg);">
                        <tr>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Produce</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Category</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Price</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Current Stock</th>
                            <th style="padding:16px 20px;border-bottom:none;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;">Status</th>
                            <th style="padding:16px 20px;border-bottom:none;text-align:right;">Quick Update</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var isLow = p.StockQuantityKg < 10;
                            var isOut = p.StockQuantityKg == 0 || !p.IsAvailable;

                            <tr>
                                <td style="padding:16px 20px;">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" style="width:42px;height:42px;border-radius:8px;object-fit:cover;border:1px solid var(--border);" />
                                        }
                                        <div>
                                            <div style="font-weight:700;color:var(--heading);">@p.Name</div>
                                            @if (p.IsOrganic)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:10px;">Organic</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge bg-light text-dark border">@(p.Category?.Name ?? "General")</span>
                                </td>
                                <td style="padding:16px 20px;">
                                    <div style="font-weight:700;color:var(--heading);">$@p.PricePerKg.ToString("F2")</div>
                                    <div style="font-size:11px;color:var(--muted);">per @p.Unit</div>
                                </td>
                                <td style="padding:16px 20px;">
                                    <span class="badge @(isOut ? "bg-danger" : isLow ? "bg-warning text-dark" : "bg-success") px-2 py-1" style="font-size:13px;font-weight:700;">
                                        @p.StockQuantityKg @p.Unit
                                    </span>
                                </td>
                                <td style="padding:16px 20px;">
                                    @if (!p.IsAvailable || p.StockQuantityKg == 0)
                                    {
                                        <span class="badge bg-secondary">Sold Out</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In Stock</span>
                                    }
                                </td>
                                <td style="padding:16px 20px;text-align:right;">
                                    <div class="d-inline-flex gap-2 align-items-center">
                                        <!-- Quick Restock (+10) -->
                                        <form asp-area="Farmer" asp-controller="Inventory" asp-action="QuickRestock" asp-route-id="@p.Id" asp-route-addQuantity="10" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success btn-pill" title="Add 10 to stock">
                                                +10 @p.Unit
                                            </button>
                                        </form>

                                        <!-- Edit Stock Modal Trigger -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-pill" data-bs-toggle="modal" data-bs-target="#editStockModal-@p.Id">
                                            <i class="fas fa-sliders-h me-1"></i>Set Stock
                                        </button>
                                    </div>

                                    <!-- Modal -->
                                    <div class="modal fade" id="editStockModal-@p.Id" tabindex="-1" aria-hidden="true" style="text-align:left;">
                                        <div class="modal-dialog">
                                            <div class="modal-content" style="border-radius:var(--radius);border:1px solid var(--border);">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" style="font-weight:700;">Set Stock: @p.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-area="Farmer" asp-controller="Inventory" asp-action="UpdateStock" asp-route-id="@p.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label" style="font-weight:600;font-size:13px;">Stock Quantity (@p.Unit)</label>
                                                            <input type="number" name="stockQuantityKg" value="@p.StockQuantityKg" min="0" class="form-control" required style="border:1px solid var(--border);" />
                                                        </div>
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" name="isAvailable" value="true" id="avail-@p.Id" @(p.IsAvailable ? "checked" : "") />
                                                            <label class="form-check-label" for="avail-@p.Id" style="font-weight:600;font-size:13px;">
                                                                Available for Customer Ordering
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary-green">Update Stock</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
